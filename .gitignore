# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
env/
test-env/
*-env/
# Gapless Crypto Data checkpoint files (auto-generated during collection)
.gapless_checkpoints/

# macOS system files
.DS_Store
*/.DS_Store

# Test coverage artifacts
.coverage
coverage.json
htmlcov/

# Type checking and testing caches
.mypy_cache/
.pytest_cache/

# .Sessions folder - never delete
.sessions/
!.sessions/.gitignore

# Lychee link checker output
.lycheecache
.lychee-results.*
# Legacy explicit names, kept so old checkouts stay covered
.lychee-results.txt
.lychee-results.json
.lychee-results.md

# Scratch/report output directory. lychee.toml writes its report here.
tmp/*
!tmp/.gitkeep

# Node.js (semantic-release)
node_modules/
package-lock.json

# Earthly logs and artifacts
logs/
