# QuestDB systemd service for Linux production
# Native binary deployment (no Docker overhead)
#
# Installation:
#   1. Download QuestDB binary from https://questdb.io/download/
#   2. Extract to /opt/questdb/
#   3. Create questdb user: sudo useradd -r -s /bin/false questdb
#   4. Set ownership: sudo chown -R questdb:questdb /opt/questdb
#   5. Copy this file to /etc/systemd/system/questdb.service
#   6. Reload systemd: sudo systemctl daemon-reload
#   7. Enable service: sudo systemctl enable questdb
#   8. Start service: sudo systemctl start questdb
#
# Directory structure:
#   /opt/questdb/bin/           # QuestDB binaries
#   /var/lib/questdb/db/        # Data directory
#   /var/log/questdb/           # Log directory
#   /etc/questdb/server.conf    # Configuration file

[Unit]
Description=QuestDB Time-Series Database
Documentation=https://questdb.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=questdb
Group=questdb

# Working directory
WorkingDirectory=/opt/questdb

# QuestDB binary execution
ExecStart=/opt/questdb/bin/java \
    -Xms24g \
    -Xmx48g \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -Dlog.dir=/var/log/questdb \
    -Dcairo.root=/var/lib/questdb/db \
    -Dcairo.wal.enabled.default=true \
    -Dmetrics.enabled=true \
    -Dhttp.bind.to=0.0.0.0:9000 \
    -Dpg.net.bind.to=0.0.0.0:8812 \
    -Dline.tcp.net.bind.to=0.0.0.0:9009 \
    -jar /opt/questdb/questdb.jar

# Restart policy
Restart=on-failure
RestartSec=10s

# Logging (systemd journal)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=questdb

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/questdb /var/log/questdb

# Resource limits (adjust based on hardware)
LimitNOFILE=1048576
LimitNPROC=4096

# Environment variables
Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64"
Environment="TZ=UTC"

[Install]
WantedBy=multi-user.target

# Management commands:
#   sudo systemctl start questdb      # Start service
#   sudo systemctl stop questdb       # Stop service
#   sudo systemctl restart questdb    # Restart service
#   sudo systemctl status questdb     # View status
#   sudo journalctl -u questdb -f     # View logs (live)
#   sudo journalctl -u questdb --since "1 hour ago"  # View recent logs

# Performance tuning notes:
#
# 1. JVM Heap Sizing:
#    - Minimum (-Xms): 50% of available RAM
#    - Maximum (-Xmx): 80% of available RAM
#    - Example: 64GB RAM → -Xms24g -Xmx48g
#
# 2. Garbage Collection:
#    - G1GC recommended for low-latency workloads
#    - MaxGCPauseMillis=200 balances throughput and latency
#
# 3. File Descriptors:
#    - LimitNOFILE=1048576 for high-cardinality symbols
#    - Check current limit: ulimit -n
#
# 4. WAL Mode:
#    - cairo.wal.enabled.default=true enables concurrent writes
#    - Required for CloudFront + WebSocket + API ingestion
#
# 5. Data Directory:
#    - Use fast SSD/NVMe storage for /var/lib/questdb
#    - XFS or ext4 filesystem recommended
#    - Avoid network-mounted storage (NFS/CIFS)
